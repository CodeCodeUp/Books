        <mxCell id="alg_title" parent="1" style="text;html=1;fontSize=15;fontStyle=1;fontColor=#000000;" value="四、核心算法原理" vertex="1">
          <mxGeometry height="30" width="200" x="1400" y="60" as="geometry" />
        </mxCell>
        <mxCell id="alg1" parent="1" style="rounded=0;whiteSpace=wrap;fillColor=none;strokeColor=#000000;fontSize=10;align=left;spacingLeft=8;" value="用户协同过滤 (User CF)&#xa;1.找共同评分图书&gt;=2的用户&#xa;2.余弦相似度&gt;0.6, Top50&#xa;3.取前20相似用户的高分书&#xa;4.加权平均预测评分:&#xa;  pred=Sum(rating x sim)/Sum(sim)&#xa;5.至少2个用户评过才纳入" vertex="1">
          <mxGeometry height="120" width="240" x="1350" y="100" as="geometry" />
        </mxCell>
        <mxCell id="alg2" parent="1" style="rounded=0;whiteSpace=wrap;fillColor=none;strokeColor=#000000;fontSize=10;align=left;spacingLeft=8;" value="物品协同过滤 (Item CF)&#xa;1.获取目标书的所有评分用户&#xa;2.找这些用户评过的其他书&#xa;3.构建共同用户评分向量&#xa;4.余弦相似度&gt;0.1&#xa;5.按相似度排序返回Top-K" vertex="1">
          <mxGeometry height="105" width="240" x="1350" y="240" as="geometry" />
        </mxCell>
        <mxCell id="alg3" parent="1" style="rounded=0;whiteSpace=wrap;fillColor=none;strokeColor=#000000;fontSize=10;align=left;spacingLeft=8;" value="TF-IDF 内容推荐&#xa;1.提取图书特征矩阵(1502维)&#xa;  =TF-IDF(标题+作者+出版社)&#xa;  +年份标准化+评分标准化&#xa;2.构建用户画像向量:&#xa;  user=Sum(rating x vec)/Sum(r)&#xa;3.批量余弦相似度&#xa;4.流行度过滤(count&gt;=10)" vertex="1">
          <mxGeometry height="130" width="240" x="1350" y="365" as="geometry" />
        </mxCell>
        <mxCell id="alg4" parent="1" style="rounded=0;whiteSpace=wrap;fillColor=none;strokeColor=#000000;fontSize=10;align=left;spacingLeft=8;" value="混合推荐策略&#xa;个人推荐:&#xa;  cf_ratio=0.50+0.40 x conf&#xa;  conf=(相似用户/50) x avg_sim&#xa;  范围[50%,90%]&#xa;图书详情:&#xa;  cf_ratio=0.40+0.45 x conf&#xa;  conf=评分数 x CF质量&#xa;  范围[40%,85%]" vertex="1">
          <mxGeometry height="145" width="240" x="1350" y="515" as="geometry" />
        </mxCell>
        <mxCell id="lg_bg" parent="1" style="rounded=1;fillColor=none;strokeColor=#000000;" value="" vertex="1">
          <mxGeometry height="150" width="210" x="1650" y="240" as="geometry" />
        </mxCell>
