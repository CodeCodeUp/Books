        <mxCell id="sr3c" parent="1" style="rounded=1;whiteSpace=wrap;fillColor=none;strokeColor=#000000;dashed=1;dashPattern=8 4;fontSize=10;" value="策略3: 动态混合&#xa;(有评分+无特征)&#xa;CF + TF-IDF" vertex="1">
          <mxGeometry height="55" width="150" x="420" y="490" as="geometry" />
        </mxCell>
        <mxCell id="sr3d" parent="1" style="rounded=1;whiteSpace=wrap;fillColor=none;strokeColor=#000000;dashed=1;dashPattern=8 4;fontSize=10;" value="策略4: 特征推荐&#xa;(无评分+有特征)&#xa;兴趣优先 -&gt; 年龄辅助&#xa;-&gt; 质量兜底" vertex="1">
          <mxGeometry height="70" width="160" x="590" y="490" as="geometry" />
