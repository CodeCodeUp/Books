        <mxCell id="sr3e" parent="1" style="rounded=0;whiteSpace=wrap;fillColor=none;strokeColor=#000000;fontSize=10;" value="策略5: 热门兜底&#xa;(无评分+无特征)&#xa;优质热门图书&#xa;avg&gt;=4.0, count&gt;=20" vertex="1">
