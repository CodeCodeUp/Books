        <mxCell id="sr2" parent="1" style="rhombus;whiteSpace=wrap;fillColor=none;strokeColor=#000000;" value="查询用户状态&#xa;有评分? 有兴趣?&#xa;有年龄?" vertex="1">
          <mxGeometry height="80" width="170" x="530" y="240" as="geometry" />
        </mxCell>
        <mxCell id="sr3a" parent="1" style="rounded=1;whiteSpace=wrap;fillColor=none;strokeColor=#000000;dashed=1;dashPattern=8 4;fontSize=10;" value="策略1: 三层混合&#xa;(有评分+有兴趣)&#xa;CF + TF-IDF + 兴趣加权&#xa;similarity+30%&#xa;predicted_rating+15%" vertex="1">
          <mxGeometry height="85" width="180" x="420" y="370" as="geometry" />
        </mxCell>
        <mxCell id="sr3b" parent="1" style="rounded=1;whiteSpace=wrap;fillColor=none;strokeColor=#000000;dashed=1;dashPattern=8 4;fontSize=10;" value="策略2: 双层混合&#xa;(有评分+有年龄)&#xa;CF + TF-IDF 动态比例" vertex="1">
