        <mxCell id="sr1" parent="1" style="rounded=1;whiteSpace=wrap;fillColor=none;strokeColor=#000000;dashed=1;dashPattern=8 4;fontStyle=1;" value="hybrid.get_hybrid_user&#xa;_recommendations()" vertex="1">
